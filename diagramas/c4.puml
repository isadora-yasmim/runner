@startuml C4_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(user, "Usuário", "Interage via linha de comando")

System_Boundary(system, "Sistema Runner") {

    Container(cli, "CLI Runner", "Go", "Interface de linha de comando e orquestração")

    Container(assinador, "Assinador", "Java (JAR)", "Responsável por assinar e verificar arquivos")

    Container(simulador, "Simulador HubSaúde", "JAR externo", "Simula integração com sistema externo")
}

System_Ext(pkcs11, "Dispositivo PKCS#11", "Token criptográfico")

Rel(user, cli, "Executa comandos")
Rel(cli, assinador, "Executa via processo ou HTTP")
Rel(cli, simulador, "Gerencia execução")
Rel(assinador, pkcs11, "Realiza operações criptográficas")

@enduml